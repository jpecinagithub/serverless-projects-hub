# ============================================================================
# Serverless Projects Hub — environment variables
# Copy to .env.local for local development (never commit real secrets).
# In Vercel: Project Settings → Environment Variables.
# ============================================================================

# --- Database (Neon Postgres via Vercel Marketplace) -------------------------
# Pooled connection string. Either name works; POSTGRES_URL takes precedence.
# Server-side only — never prefix with VITE_.
DATABASE_URL="postgres://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"
# POSTGRES_URL="postgres://user:password@ep-xxxx-pooler.neon.tech/dbname?sslmode=require"

# --- Vercel Blob (project thumbnails) ----------------------------------------
# Created automatically when you connect a Blob store in the Vercel dashboard.
# Server-side only.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# --- Admin area ---------------------------------------------------------------
# Secret that unlocks /admin (minimum 16 characters, random).
# Server-side only.
ADMIN_SECRET="change-me-to-a-long-random-secret"

# --- Local development --------------------------------------------------------
# When running `npm run dev`, the app uses built-in mock data so no
# infrastructure is needed. Set to 1 to hit real /api functions locally
# (requires the variables above in .env.local and `vercel dev`, or a proxy).
# VITE_USE_REAL_API=1

# Optional: link shown behind the GitHub icon in the header.
# VITE_GITHUB_URL="https://github.com/your-username/serverless-projects-hub"
